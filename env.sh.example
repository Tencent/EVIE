# Copy to env.sh (gitignored). Point at data / checkpoints / a virtualenv.

export EVIE_ROOT="${EVIE_ROOT:-$(pwd)}"
# Interpreter only. Do not write dumps, caches, or checkpoints into this prefix.
export PYTHON="${PYTHON:-python3}"   # or $VIRTUAL_ENV/bin/python

# Bundled toy pages (6 images). Swap these for a real dump to train.
export DATA_ROOT="${DATA_ROOT:-$EVIE_ROOT/examples/toy}"
export HARDNEG_ROOT="${HARDNEG_ROOT:-$EVIE_ROOT/examples/toy/hardneg}"

# Generated work (all gitignored).
export RUNS_DIR="${RUNS_DIR:-$EVIE_ROOT/runs}"
export LOG_DIR="${LOG_DIR:-$EVIE_ROOT/logs}"
export EVAL_ROOT="${EVAL_ROOT:-$EVIE_ROOT/data}"
export HF_HOME="${HF_HOME:-$EVIE_ROOT/.cache/huggingface}"
export HF_DATASETS_CACHE="${HF_DATASETS_CACHE:-$HF_HOME/datasets}"

# Sibling checkpoints. Teacher / student launchers set BASE_MODEL themselves
# (Qwen/Qwen3.5 and tencent/EVIE-Preview-4.5B). Override only if you need to.
export EVIE_8B_DIR="${EVIE_8B_DIR:-$EVIE_ROOT/../Evie-8B}"
export EVIE_4_5B_DIR="${EVIE_4_5B_DIR:-$EVIE_ROOT/../Evie-4.5B}"
export TEACHER_DIR="$EVIE_8B_DIR"
export MODEL_DIR="${MODEL_DIR:-$EVIE_4_5B_DIR}"
